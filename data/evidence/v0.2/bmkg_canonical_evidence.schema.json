{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rembuktani.local/schema/bmkg-canonical-evidence-v0.2.json",
  "title": "RembukTani BMKG canonical evidence v0.2",
  "type": "object",
  "required": ["evidence_id", "evidence_type", "land_ref", "decision_case_ref", "source", "provenance", "location", "temporal", "quality", "payload"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "evidence_type": {"const": "climate_external"},
    "land_ref": {"type": "object", "required": ["land_id"]},
    "decision_case_ref": {"type": "object", "required": ["decision_case_id"]},
    "source": {
      "type": "object",
      "required": ["category", "name", "attribution_required", "documentation_url"],
      "properties": {
        "category": {"enum": ["official", "official_mock"]},
        "name": {"const": "BMKG"},
        "attribution_required": {"const": true},
        "documentation_url": {"type": "string", "format": "uri"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["collection_mode", "is_mock", "fetched_at", "request", "raw_payload_ref"],
      "properties": {
        "collection_mode": {"enum": ["external_api", "fixture"]},
        "is_mock": {"type": "boolean"},
        "fetched_at": {"type": "string", "format": "date-time"},
        "request": {"type": "object", "required": ["uri"]},
        "raw_payload_ref": {"type": "string", "minLength": 1}
      }
    },
    "location": {
      "type": "object",
      "required": ["administrative", "source_point", "timezone"],
      "properties": {
        "administrative": {"type": "object", "required": ["adm4", "province", "regency", "district", "village"]},
        "source_point": {
          "type": "object",
          "required": ["lat", "lon"],
          "properties": {"lat": {"type": "number", "minimum": -90, "maximum": 90}, "lon": {"type": "number", "minimum": -180, "maximum": 180}}
        },
        "timezone": {"type": "string", "minLength": 1}
      }
    },
    "temporal": {
      "type": "object",
      "required": ["analysis_time", "first_target_time", "last_target_time"],
      "properties": {
        "analysis_time": {"type": "string", "format": "date-time"},
        "first_target_time": {"type": "string", "format": "date-time"},
        "last_target_time": {"type": "string", "format": "date-time"}
      }
    },
    "quality": {
      "type": "object",
      "required": ["level", "basis"],
      "properties": {"level": {"enum": ["high", "medium", "low", "unknown"]}, "basis": {"type": "string"}}
    },
    "payload": {
      "type": "object",
      "required": ["analysis_time", "forecast_slots"],
      "properties": {
        "analysis_time": {"type": "string", "format": "date-time"},
        "forecast_slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["target_time_utc", "target_time_local", "weather_desc"],
            "properties": {
              "target_time_utc": {"type": "string", "format": "date-time"},
              "target_time_local": {"type": "string"},
              "t": {"type": ["number", "null"]},
              "hu": {"type": ["number", "null"]},
              "weather_desc": {"type": "string"},
              "weather_desc_en": {"type": ["string", "null"]},
              "ws": {"type": ["number", "null"]},
              "wd": {"type": ["string", "null"]},
              "tcc": {"type": ["number", "null"]},
              "vs_text": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {"properties": {"category": {"const": "official"}}}
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "collection_mode": {"const": "external_api"},
              "is_mock": {"const": false}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {"properties": {"category": {"const": "official_mock"}}}
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "collection_mode": {"const": "fixture"},
              "is_mock": {"const": true}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
