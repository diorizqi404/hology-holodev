{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "spike:location": "tsx src/infrastructure/location/location-resolution-spike.ts",
    "test": "tsx --test tests/unit/bmkg-adapter.test.ts tests/unit/reasoning.test.ts tests/unit/llm-reasoning-enhancer.test.ts",
    "test:ai-contract": "npm run build && node --test tests/contract/ai-reasoning-contract.test.mjs",
    "test:auth-contract": "npm run build && node --test tests/contract/auth-identity-contract.test.mjs",
    "test:location-contract": "npm run build && node --test tests/contract/location-mapping-contract.test.mjs",
    "test:brief-contract": "npm run build && node --test tests/contract/decision-brief-contract.test.mjs",
    "test:ai-live": "npm run build && node scripts/live-ai-smoke.mjs",
    "test:e2e-reviewer": "node scripts/e2e-reviewer-flow.mjs",
    "typecheck:demo": "tsc --noEmit --ignoreConfig --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --esModuleInterop --skipLibCheck --types node scripts/demo-seed.ts scripts/demo-reset.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:reset": "tsx scripts/demo-reset.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2"
  }
}
