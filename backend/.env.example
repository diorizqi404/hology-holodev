# ===================================
# Supabase Configuration
# ===================================

# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Anon key (safe for frontend/browser)
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (SECRET - backend only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret (for Supabase Auth verification)
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Direct database connection (optional, for migrations)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ===================================
# Server Configuration
# ===================================

NODE_ENV=development
PORT=3000
# Pisahkan beberapa origin dengan koma. Sertakan hostname yang dipakai browser lokal.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ===================================
# BMKG Integration (Climate Service)
# ===================================

BMKG_API_BASE_URL=https://data.bmkg.go.id
BMKG_FORECAST_ENDPOINT=/prakiraan-cuaca/
BMKG_CACHE_TTL_MINUTES=120

# ===================================
# Location Service
# ===================================

LOCATION_RESOLVER_TYPE=manual  # or 'geocoding', 'bmkg'

# Optional: Geocoding service (e.g., Google Maps API)
# GEOCODING_API_KEY=your-api-key

# ===================================
# Reasoning Service
# ===================================

REASONING_SERVICE_URL=http://localhost:8000
REASONING_SERVICE_TIMEOUT_MS=5000

# Optional LLM enhancement. The deterministic water-v0.2 engine remains the safe fallback.
LLM_ENABLED=true
GEMINI_API_KEY=your-google-ai-studio-key
LLM_MODEL=gemini-3.5-flash

# ===================================
# Logging & Monitoring
# ===================================

LOG_LEVEL=debug
SENTRY_DSN=  # Optional: error tracking

# ===================================
# Feature Flags
# ===================================

ENABLE_MOCK_DATA=true
ENABLE_TRUSTED_REVIEW=false  # Optional feature for M2
FORCE_DEMO_MODE=false        # Use demo/fixture data only

# Demo seed (local/staging only)
DEMO_USER_EMAIL=demo@rembuktani.local
DEMO_USER_PASSWORD=change-this-demo-password
